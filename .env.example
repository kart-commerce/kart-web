# Copy to .env and fill in for your environment. Never commit the real .env.
#
# Every URL below has a localhost:<port> fallback baked into its client (see the
# Environment variables table in README.md), so a missing variable fails *silently*
# into "trying to reach a service that probably isn't running" — there's no crash,
# just an empty/degraded response. Set these explicitly for anything beyond one
# developer's local box.

# kart-identity-service (src/server/bff/identity-client.ts). Port 8081 is
# kart-identity-service's own local dev port (its launchSettings.json http profile) —
# the same host port kart-devops/docker-compose.yml maps it to.
IDENTITY_SERVICE_BASE_URL=http://localhost:8081

# kart-api-gateway base URL for the Angular app's generated clients (src/app/core/config/
# app-config.ts). Port 8100 matches kart-api-gateway's own local dev port and
# kart-devops/docker-compose.yml's host port for it.
GATEWAY_BASE_URL=http://localhost:8100

# Session store (src/server/bff/session-store.ts). Port 6380 is kart-devops/docker-compose.yml's
# host-mapped port for its shared Redis container (6379 is commonly already bound by a local
# Redis install) — point at 6379 instead if you're running your own standalone Redis.
REDIS_URL=redis://localhost:6380

# BFF session store + cookie Max-Age — matches security.md's native-login absolute session cap.
SESSION_TTL_SECONDS=7776000

# @angular/ssr's built-in Host-header SSRF guard rejects any Host it doesn't recognize
# (hostname only, no port). Required for any real request to succeed.
NG_ALLOWED_HOSTS=localhost

# Standard Node/Express
NODE_ENV=development
PORT=4000
