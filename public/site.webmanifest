{
  "name": "Kart",
  "short_name": "Kart",
  "description": "Browse, search, cart, checkout, and track orders — installable for a native-app-like mobile experience.",
  "start_url": "/",
  "scope": "/",
  "icons": [
    {
      "src": "/web-app-manifest-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/web-app-manifest-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "theme_color": "#2A6DF4",
  "background_color": "#FFFFFF",
  "display": "standalone",
  "orientation": "portrait-primary"
}
